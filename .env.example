# ---------------------------------------------------------------------------
# relic-bot configuration
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Private keys do NOT go here: they live as individual files in RELIC_KEYS_DIR.
# ---------------------------------------------------------------------------

RELIC_BASE_URL=https://playrelic.gg

# Directory holding one secret-key file per account (chmod 700).
# Each file: chmod 600, containing either a base58 secret key (Phantom export)
# or a JSON array of 64 integers (solana-keygen). Filename becomes the account id.
RELIC_KEYS_DIR=/root/.relic-bot/keys

RELIC_DATA_DIR=/root/relic-bot/data
LOG_LEVEL=info

# --- Solana (read-only; used for RELIC balance and doctor checks) -----------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Fleet pacing ----------------------------------------------------------
# One live session per account is enforced by the server (device_busy).
FLEET_MAX_CONCURRENT=10
FLEET_START_STAGGER_MS=20000
ACTION_TEMPO_MS=1400
ACTION_JITTER_PCT=35

# --- Liveness watchdog -----------------------------------------------------
# Alert when an account has produced NO value for this long, even at 0 errors.
WATCHDOG_SILENCE_MIN=25

# --- Treasury (the ONLY transaction-signing surface) -----------------------
# Wallet id (e.g. wallet-01) or address that sweeps collect into and that gas
# is funded from. Blank = the first wallet. Set it from Telegram or with:
#   npm run ctl -- main wallet-01
RELIC_MAIN_ACCOUNT=

# Top up a wallet when its SOL falls below GAS_MIN_SOL, sending GAS_TOPUP_SOL.
# GAS_MAX_SOL is a hard per-transfer ceiling enforced in code.
GAS_MIN_SOL=0.003
GAS_TOPUP_SOL=0.01
GAS_MAX_SOL=0.05

# Sweep residual SOL as well as tokens (a dust reserve is always left behind).
SWEEP_INCLUDE_SOL=false

# --- Selling (the only revenue channel; needs no signature) ----------------
SELL_ENABLED=true
# Skip loot whose net proceeds fall below this (micro-USDC; 50000 = $0.05).
SELL_MIN_NET_MICRO_USDC=50000
# auto | usdc | relic
SELL_CURRENCY_PREFERENCE=auto
# Marketplace fee is 10% for USDC and 5% for RELIC (seller-paid), but RELIC is
# volatile. This discount is applied to RELIC proceeds before comparing.
# 8 => USDC preferred; below ~5.26 => RELIC preferred.
RELIC_VOLATILITY_DISCOUNT_PCT=8

# --- Otak (LLM brain) ------------------------------------------------------
# With OTAK_ENABLED=false the bot still plays fully on deterministic heuristics.
OTAK_ENABLED=false
OTAK_PROVIDER=anthropic
OTAK_TIMEOUT_MS=20000
OTAK_MAX_CALLS_PER_HOUR=60

# Keys may be set here, or entered at runtime via Telegram (/otak key <provider>),
# which stores them encrypted at rest. An env var always takes precedence.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# FUGU_API_KEY=

# Optional Anthropic tuning. Default model is claude-opus-5.
# OTAK_ANTHROPIC_MODEL=claude-opus-5
# OTAK_ANTHROPIC_EFFORT=low
# FUGU_BASE_URL=https://api.sakana.ai/v1
# FUGU_MODEL=fugu-1

# --- Telegram control ------------------------------------------------------
# Get a token from @BotFather. Owner ids from @userinfobot (comma-separated).
# The bot ignores every chat not in this list.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_IDS=
